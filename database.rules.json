{
  "rules": {
    ".read": false,
    ".write": false,
    "swimmers": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && $uid === auth.uid",
        ".validate": "newData.hasChildren(['name','lane','style','gender','t'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 4"
        },
        "lane": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 4"
        },
        "style": {
          ".validate": "newData.val() === 'free' || newData.val() === 'back' || newData.val() === 'fly' || newData.val() === 'breast' || newData.val() === 'kick'"
        },
        "wear": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "gender": {
          ".validate": "newData.val() === 'f' || newData.val() === 'm'"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
